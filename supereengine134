// SuperEngine.cpp (key filled-out parts)
#include "SuperEngine.hpp"
#include <iostream>

bool SuperEngine::init(GraphicsAPI api, void* nativeWindow, int w, int h) {
    width = w; height = h;
    // Factory – expand for Vulkan / DX12
    rhi = std::make_unique<OpenGLRHI>(); // implement this class
    if (!rhi->init(nativeWindow, w, h)) return false;

    proj = mat4_t::perspective(1.047f /*60°*/, float(w)/h, 0.1f, 250.f);

    spawnSovereign();

    // 15 GateOfSovereign relics scattered for the campaign structure
    for (int i = 0; i < 15; ++i) {
        Entity gate;
        gate.type = EntityType::GateOfSovereign;
        gate.name = "Gate of the Crimson Throne #" + std::to_string(i + 1);
        gate.position = {
            (i % 5) * 8.f - 16.f,
            0.f,
            (i / 5) * 8.f - 8.f
        };
        gate.scale = {1.5f, 3.f, 1.5f};
        gate.material.albedo = {0.9f, 0.05f, 0.12f};
        gate.crimsonPower = 25.f + i * 5.f;
        entities.push_back(gate);
    }

    spawnWave(8); // starting enemies
    std::cout << "[Crimson Sovereign] Engine online – 15 Gates initialized.\n";
    return true;
}

void SuperEngine::spawnSovereign() {
    Entity sov;
    sov.type = EntityType::Sovereign;
    sov.name = "Crimson Sovereign";
    sov.position = {0.f, 0.f, 0.f};
    sov.scale = {1.2f, 1.2f, 1.2f};
    sov.material.albedo = {0.95f, 0.08f, 0.18f};
    sov.material.metallic = 0.7f;
    sov.health = 200.f;
    sov.crimsonPower = 100.f;
    entities.push_back(sov);
    player = &entities.back();
}

void SuperEngine::spawnWave(int count) {
    for (int i = 0; i < count; ++i) {
        Entity e;
        e.type = EntityType::CrimsonWraith;
        e.name = "Wraith " + std::to_string(entities.size());
        e.position = {
            (rand() % 40 - 20) * 1.f,
            0.f,
            (rand() % 40 - 20) * 1.f
        };
        e.material.albedo = {0.6f, 0.02f, 0.08f};
        e.health = 40.f + (rand() % 30);
        entities.push_back(e);
    }
}

void SuperEngine::update(float dt) {
    time += dt;
    // Simple orbit camera around the Sovereign
    cameraPos.x = std::sin(time * 0.25f) * 14.f;
    cameraPos.z = std::cos(time * 0.25f) * 14.f;
    cameraPos.y = 4.f + std::sin(time * 0.4f) * 1.5f;
    cameraTarget = player ? player->position : vec3_t{0,1,0};

    view = mat4_t::lookAt(cameraPos, cameraTarget, {0,1,0});

    // Basic AI / power pulse for atmosphere
    for (auto& e : entities) {
        if (e.type == EntityType::CrimsonWraith && player) {
            vec3_t dir = (player->position - e.position).normalized();
            e.position = e.position + dir * (dt * 1.8f);
        }
        // Pulse crimson power
        e.crimsonPower = std::fmod(e.crimsonPower + dt * 10.f, 100.f);
    }
}

void SuperEngine::render() {
    rhi->beginFrame();
    mat4_t viewProj = proj * view;

    for (const auto& e : entities) {
        mat4_t model = mat4_t::translate(e.position) * mat4_t::scale(e.scale);
        // Pass material + crimsonPower as uniforms for the “super graphics” look
        rhi->draw(e, model, viewProj); // extended draw that takes Entity
    }
    rhi->endFrame();
}

void SuperEngine::shutdown() {
    if (rhi) rhi->shutdown();
    entities.clear();
    player = nullptr;
}